# Environment variables
# Copy this file to .env and adjust as needed:  cp .env.example .env

SECRET_KEY="django-insecure-dev-key-please-change-in-production"
ENV_TYPE="dev"
DEBUG=True
DOMAIN_NAME="http://localhost:8000"

# The web app's base URL. Every link this system emails is built from it: the
# magic-link sign-in URL, the customer's invoice and estimate portal links, the
# CSAT survey, and the internal "assigned to you" notifications. Outside dev
# (ENV_TYPE other than "dev") a loopback value is refused at startup, because
# left at this default it mails customers a link to their own machine.
FRONTEND_URL="http://localhost:5173"

# AWS (only needed for production / S3 storage)
AWS_BUCKET_NAME=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SES_REGION_NAME=""
AWS_SES_REGION_ENDPOINT=""
# Dedicated SES sender credentials; never replace the S3 keys above.
AWS_SES_ACCESS_KEY_ID=""
AWS_SES_SECRET_ACCESS_KEY=""
AWS_SES_CONFIGURATION_SET=""

# DB
DBNAME="crm_db"
DBUSER="postgres"
DBPASSWORD="postgres"
DBHOST="localhost"
DBPORT="5432"


# Celery
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Google OAuth (optional: leave blank to disable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_PROJECT_ID=""
# Declare the system sender's existing project before enabling isolated integrations.
GMAIL_SYSTEM_PROJECT_ID=""

# Email (use "django.core.mail.backends.console.EmailBackend" for dev, "django_ses.SESBackend" for AWS SES)
EMAIL_BACKEND="django.core.mail.backends.console.EmailBackend"
DEFAULT_FROM_EMAIL="noreply@localhost"
ADMIN_EMAIL="admin@localhost"

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Set to True only when TLS is terminated by a proxy in front of Django and that
# proxy is the only way in. It makes Django trust X-Forwarded-Proto, which is
# what lets the HSTS settings emit a header at all. Leave False for direct HTTP
# or the header becomes something any caller can forge.
TRUST_PROXY_SSL_HEADER=False
# Comma-separated CIDRs of verified ingress proxies, not client networks.
# Only these peers may supply X-Forwarded-For. Leave empty for direct access.
# Proxies must overwrite XFF or append the real peer; never trust 0.0.0.0/0.
DJANGO_TRUSTED_PROXY_CIDRS=
# Alternative to CIDRs; 0 disables. Verify all ingress routes before enabling.
DJANGO_TRUSTED_PROXY_HOPS=0
# Dedicated 32-byte random key encoded as 64 hex characters; same secret in Web.
CRM_PROXY_SIGNING_KEY=

# Shared cache. Required in production for DRF throttling to be enforced across
# workers rather than per process. Without it the public web form rate limits
# are per gunicorn worker and reset on restart.
CACHE_URL=""
# Database allocation in bytes, confirmed with your hosting provider; 0 = unknown.
# Remaining space is an estimate excluding WAL, logs and other databases.
CRM_DATABASE_CAPACITY_BYTES=0

# Public web form submission limits (issue #634). The first is per client IP
# per form; the second is per form across all clients and is the layer that
# X-Forwarded-For rotation cannot evade.
WEBFORM_THROTTLE_IP="10/hour"
WEBFORM_THROTTLE_GLOBAL="200/day"

# Personal Google mailbox/calendar integration (independent of system sender).
GOOGLE_INTEGRATION_CLIENT_ID=""
GOOGLE_INTEGRATION_CLIENT_SECRET=""
GOOGLE_INTEGRATION_ENCRYPTION_KEY=""
GOOGLE_INTEGRATION_PROJECT_ID=""

# Optional staged migration to separate Cloud projects. Do not reuse the login,
# legacy integration or system sender project. Keep old credentials during migration.
GOOGLE_GMAIL_CLIENT_ID=""
GOOGLE_GMAIL_CLIENT_SECRET=""
GOOGLE_GMAIL_PROJECT_ID=""
# Optional authenticated Pub/Sub notifications; leave all empty for polling only.
GOOGLE_GMAIL_PUSH_TOPIC=""
GOOGLE_GMAIL_PUSH_SUBSCRIPTION=""
GOOGLE_GMAIL_PUSH_AUDIENCE=""
GOOGLE_GMAIL_PUSH_SERVICE_ACCOUNT=""
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_PROJECT_ID=""
GOOGLE_CALENDAR_PUSH_URL=""

# Owner-only start/cancel of a 30-day organization closure.
CRM_ORG_CLOSURE_ENABLED=True
# Delete closed tenants after 30 days; false is an emergency operational pause.
CRM_ORG_PURGE_ENABLED=True
