# Google OAuth (client_id only - secret is on backend)
GOOGLE_CLIENT_ID="your-google-client-id-here"
GOOGLE_LOGIN_DOMAIN="http://localhost:5173"

# Django API URL (PUBLIC_ prefix makes it available in both server and browser)
PUBLIC_DJANGO_API_URL=http://localhost:8000


# Environment
NODE_ENV=development

# Optional server-only connection to Django (e.g. Render private network).
# Keep PUBLIC_DJANGO_API_URL as the public HTTPS URL.
DJANGO_INTERNAL_API_URL=

# Web-to-API signed visitor identity (server-only; same dedicated key in API).
CRM_PROXY_SIGNING_KEY=
# Hosted adapter-node only: verify the ingress chain BEFORE setting these.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=2

# Temporary operator probe ID, not a credential. Leave empty outside ingress checks.
CRM_PROXY_DIAGNOSTIC_ID=

# Optional navigation diagnostics: numeric Server-Timing and browser duration only.
# Disabled by default. Enable temporarily on comparison builds, never log user data.
CRM_PERFORMANCE_DIAGNOSTICS=false
